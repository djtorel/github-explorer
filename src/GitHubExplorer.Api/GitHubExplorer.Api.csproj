<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UserSecretsId>0a14043a-a501-4f8c-9235-99004ff12ac1</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitHubExplorer.Application\GitHubExplorer.Application.csproj" />
    <ProjectReference Include="..\GitHubExplorer.Domain\GitHubExplorer.Domain.csproj" />
    <ProjectReference Include="..\GitHubExplorer.Infrastructure\GitHubExplorer.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.1" />
  </ItemGroup>

  <PropertyGroup>
    <BuildFrontend Condition="'$(BuildFrontend)' == ''">true</BuildFrontend>
    <SpaRoot>$(MSBuildProjectDirectory)\..\frontend\</SpaRoot>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(SpaRoot)node_modules\**</DefaultItemExcludes>
  </PropertyGroup>

  <Target Name="EnsureNodeModules" BeforeTargets="BuildFrontend" Condition="'$(BuildFrontend)' == 'true' And !Exists('$(SpaRoot)node_modules')">
    <Message Text="Installing frontend dependencies..." Importance="high" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm install" />
  </Target>

  <Target Name="BuildFrontend" BeforeTargets="Build" Condition="'$(BuildFrontend)' == 'true'">
    <Message Text="Building frontend..." Importance="high" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
  </Target>

</Project>
